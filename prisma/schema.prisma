generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id                  String   @id @default(uuid())
  name                String   @unique
  purchase_price      Float    
  selling_price       Float    
  stock_quantity      Int      @default(0) 
  promotion_quantity  Int      @default(0) 
  promotion_price     Float?   
  isActive            Boolean  @default(true)
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  orders              Order[]
  
  @@index([name])
}


enum PaymentMethod {
  CASH           
  SCAN           
  THAI_HELP     
}


model Order {
  id              String   @id @default(uuid())
  productID       String
  quantity        Int
  payment_method  PaymentMethod
  
  // Snapshot
  unit_cost           Float?   // ราคาต้นทุนต่อหน่วยขณะขาย
  unit_price          Float?   // ราคาขายต่อหน่วยขณะขาย (เฉลี่ยหลังโปร)
  selling_price       Float?   // ราคาขายปกติขณะขาย (ก่อนโปร)
  
  // เก็บ Promotion ขณะขาย
  promotion_quantity  Int?     // จำนวนที่ต้องซื้อเพื่อได้โปร (เช่น ซื้อ 3)
  promotion_price     Float?   // ราคาโปรโมชั่น (เช่น 3 ขวด 100 บาท)
  has_promotion       Boolean  @default(false) // มีใช้โปรหรือไม่
  
  totalAmount         Float    // ยอดรวมที่ขาย
  totalCost           Float?   // ต้นทุนรวม
  
  createdAt           DateTime @default(now())
  isDelivery          Boolean  @default(false)
  note                String?  // หมายเหตุ
  

  product         Product  @relation(fields: [productID], references: [id], onDelete: Cascade)
  
  @@index([productID])
  @@index([createdAt])
}
